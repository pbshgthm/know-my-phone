OPENROUTER_API_KEY=sk-or-your-openrouter-key
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id
# Optional STT model ID (default: scribe_v2)
# ELEVENLABS_STT_MODEL_ID=scribe_v2
# Optional per-language voice IDs (fallbacks to ELEVENLABS_VOICE_ID)
# ELEVENLABS_VOICE_ID_EN=
# ELEVENLABS_VOICE_ID_TA=
# ELEVENLABS_VOICE_ID_HI=
# ELEVENLABS_VOICE_ID_KN=
# ELEVENLABS_VOICE_ID_TE=
PORT=8765

# LLM Model Configuration (via OpenRouter)
# Options: openai/gpt-5.2, openai/gpt-4o, openai/gpt-4-turbo, google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet
LLM_TEXT_MODEL=openai/gpt-5.2
LLM_VISION_MODEL=openai/gpt-5.2
