OPENAI_API_KEY=sk-your-openai-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id
PORT=8765

# LLM Model Configuration (via OpenRouter)
# Options: openai/gpt-5.2, openai/gpt-4o, openai/gpt-4-turbo, google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet
LLM_TEXT_MODEL=openai/gpt-5.2
LLM_VISION_MODEL=openai/gpt-5.2
