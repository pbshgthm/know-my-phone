# Server
PORT=8765

# LLM
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Optional when using google/* models
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
LLM_TEXT_MODEL=anthropic/claude-4.5-haiku
LLM_VISION_MODEL=anthropic/claude-4.5-haiku

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-key

# STT
ELEVENLABS_STT_MODEL_ID=scribe_v2

# TTS default (used only when language code is unsupported)
ELEVENLABS_VOICE_ID=your-default-voice-id

# TTS model default
ELEVENLABS_STREAMING_MODEL=eleven_v3

# TTS voice IDs by language
# ELEVENLABS_VOICE_ID_EN=
# ELEVENLABS_VOICE_ID_TA=
# ELEVENLABS_VOICE_ID_HI=
# ELEVENLABS_VOICE_ID_KN=
# ELEVENLABS_VOICE_ID_TE=
# ELEVENLABS_VOICE_ID_ML=

# TTS model IDs by language (optional)
# ELEVENLABS_STREAMING_MODEL_EN=
# ELEVENLABS_STREAMING_MODEL_TA=
# ELEVENLABS_STREAMING_MODEL_HI=
# ELEVENLABS_STREAMING_MODEL_KN=
# ELEVENLABS_STREAMING_MODEL_TE=
# ELEVENLABS_STREAMING_MODEL_ML=
